# Achievements Configuration for Bit by Bit
# Each achievement has trigger conditions and rewards

achievements[40]:
  - id: first_click
    name: Hello World
    description: Click for the first time
    category: clicking
    icon: 👆
    trigger_type: clicks
    trigger_value: 1
    hidden: false
    rewards:
      - type: bits
        value: 10
        description: 10 bits

  - id: click_100
    name: Button Masher
    description: Click 100 times
    category: clicking
    icon: 🖱️
    trigger_type: clicks
    trigger_value: 100
    hidden: false
    rewards:
      - type: multiplier
        value: 1.05
        description: +5% production

  - id: click_1000
    name: Repetitive Strain
    description: Click 1,000 times
    category: clicking
    icon: 💪
    trigger_type: clicks
    trigger_value: 1000
    hidden: false
    rewards:
