# Bit by Bit Game Configuration - Data Shard Upgrades
# TOON format configuration for compression era meta-upgrades
# Spent Data Shards to gain permanent bonuses

data_shard_upgrades[6]:
  - id: compression_mastery
    name: Compression Mastery
    icon: 💎
    base_cost: 2
    cost_scale: 2
    max_level: 10
    effect_per_level: 10
    description: +10% compressed bits production per level
    effect_type: production_percent
    
  - id: parallel_streams
    name: Parallel Streams
    icon: 🔄
    base_cost: 3
    cost_scale: 3
    max_level: 5
    effect_per_level: 25
    description: +25% production per compression generator per level
    effect_type: generator_percent
    
  - id: efficiency_shield
    name: Efficiency Shield
    icon: 🛡️
    base_cost: 2
    cost_scale: 2
    max_level: 10
    effect_per_level: 5
    description: +5% minimum efficiency floor per level
    effect_type: efficiency_floor
    
  - id: entropy_barrier
    name: Entropy Barrier
    icon: 🌊
    base_cost: 4
    cost_scale: 4
    max_level: 5
    effect_per_level: 5
    description: Reduces efficiency penalty thresholds by 5% per level
    effect_type: penalty_threshold
    
  - id: shard_doubler
    name: Shard Doubler
    icon: ⭐
    base_cost: 10
    cost_scale: 10
    max_level: 4
    effect_per_level: 25
    description: +25% Data Shards earned on rebirth per level
    effect_type: shard_bonus
    
  - id: quick_collect
    name: Quick Collect
    icon: ⚡
    base_cost: 5
    cost_scale: 5
    max_level: 3
    effect_per_level: 10
    description: -10% bits threshold for shard collection per level
    effect_type: collect_threshold

# Upgrade balance recommendations
upgrade_balance:
  early_focus: efficiency_shield
  mid_focus: compression_mastery
  late_focus: shard_doubler
  recommended_levels:
    efficiency_shield: 5
    compression_mastery: 5
    parallel_streams: 3
    entropy_barrier: 3
